# chess.com (public API, no key)
CHESSCOM_USERNAME=your_chesscom_username
CONTACT_EMAIL=you@example.com

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...). Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server only.
SUPABASE_SECRET_KEY=
# The only account allowed to sign in
ALLOWED_EMAIL=you@example.com

# Claude (Anthropic), the coach
ANTHROPIC_API_KEY=
CLAUDE_MODEL_COACH=claude-opus-5-5
CLAUDE_MODEL_REVIEW=claude-opus-5-5

# Jev (TypeSafe) via OpenRouter's Decisions API
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13

# Voyage AI embeddings (voyage-4 family, 1024 dims)
VOYAGE_API_KEY=

# Render engine service (Maia)
ENGINE_URL=https://nimzo-engine.onrender.com
ENGINE_SHARED_SECRET=
