# chess.com (public API, no key)
CHESSCOM_USERNAME=your_chesscom_username
CONTACT_EMAIL=you@example.com

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret key (sb_secret_...). Server only; all database access goes through it.
SUPABASE_SECRET_KEY=

# Claude (Anthropic), the coach
ANTHROPIC_API_KEY=
CLAUDE_MODEL_COACH=claude-opus-5-5
CLAUDE_MODEL_REVIEW=claude-opus-5-5

# Jev (TypeSafe) via OpenRouter's Decisions API
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13

# Voyage AI embeddings (voyage-4 family, 1024 dims)
VOYAGE_API_KEY=


# Coach voice (ElevenLabs). Premade voices work on the free plan.
ELEVENLABS_API_KEY=
# Default "Bill" (premade). George: JBFqnCBsd6RMkjVDRZzb, Brian: nPczCjzI2devNBz1zQrb
ELEVENLABS_VOICE_ID=pqHfZKP75CvOlQylNhV4
ELEVENLABS_MODEL=eleven_v4
